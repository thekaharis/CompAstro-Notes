# Temp
*.tmp
*.swp
*~

# Finding-note figures: keep only the images embedded in finding notes,
# not the full diagnostic dumps from every viz run.  Track run_info.txt
# breadcrumbs so older folders remain self-describing.
wiki/thesis/findings/figures/**/*.png

